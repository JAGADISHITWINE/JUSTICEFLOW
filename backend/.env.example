# JusticeFlow Backend Configuration Template
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=justiceflow_db

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Microservice Ports
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=3001
CLIENT_SERVICE_PORT=3002
CASE_SERVICE_PORT=3003
DOCUMENTS_SERVICE_PORT=3004
TIME_TRACKING_SERVICE_PORT=3005

# Internal Service URLs
AUTH_SERVICE_URL=http://localhost:3001
CLIENT_SERVICE_URL=http://localhost:3002
CASE_SERVICE_URL=http://localhost:3003
DOCUMENTS_SERVICE_URL=http://localhost:3004
TIME_TRACKING_SERVICE_URL=http://localhost:3005
